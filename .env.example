# MailerLite v3 API key — get it from: MailerLite dashboard → Integrations → API
MAILERLITE_API_KEY=

# MailerLite group IDs — create these groups in the MailerLite dashboard
MAILERLITE_GROUP_ES_ID=
MAILERLITE_GROUP_EN_ID=

# Optional: participate/collaborate groups (subscribers who check the participate box)
MAILERLITE_PARTICIPATE_ES_ID=
MAILERLITE_PARTICIPATE_EN_ID=

# The production origin of the site (used to reject cross-origin API requests)
# Example: https://ateneo-abierto.org
SITE_ORIGIN=

# Port the Hono server listens on (default: 3000)
PORT=3000
